# --- Postgres (docker-compose + dbt profile + loader + Go API) ---
ABI_PG_HOST=localhost
ABI_PG_PORT=5432
ABI_PG_DB=abi
ABI_PG_USER=abi
ABI_PG_PASSWORD=abi

# --- MinIO (docker-compose + loader) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ABI_MINIO_ENDPOINT=http://localhost:9000
ABI_MINIO_ACCESS_KEY=minioadmin
ABI_MINIO_SECRET_KEY=minioadmin
ABI_MINIO_BUCKET=bronze

# --- Go API ---
# Binds the HTTP server; default :8080
ABI_HTTP_ADDR=:8080
# The API builds DATABASE_URL from ABI_PG_*; override explicitly if needed:
# DATABASE_URL=postgres://abi:abi@localhost:5432/abi?sslmode=disable

# --- Realtime / ops (Phase 1: producer + server) ---
ABI_KAFKA_SEED_BROKERS=localhost:29092
ABI_GRPC_ADDR=:8090
# Producer Prometheus endpoint; the server exposes /metrics on its own listener
ABI_METRICS_ADDR=:8092
ABI_SPEED_MULTIPLIER=2880
ABI_RING_CAPACITY=4096
ABI_BOT_RATIO=0.02
ABI_SESSION_CONVERSION_RATE=0.03
ABI_CONSUMER_GROUP_BRONZE=bronze-writer
ABI_CONSUMER_GROUP_RT=rt-aggregator
# Retention janitor (server): how long streaming rows survive
ABI_RETENTION_STREAM_EVENTS=12h
ABI_RETENTION_METRICS_BUCKETS=3h
ABI_RETENTION_ANOMALIES=720h
# Self-healing: recompute realtime buckets from the idempotent bronze layer
ABI_RECONCILE_EVERY=60s

# --- Phase 2 predictive layer ---
# Model-serving sidecar (ml/serve.py). Empty ABI_SCORE_URL disables live
# scoring; the read APIs (model registry + persisted predictions) keep working.
ABI_SCORE_URL=http://127.0.0.1:8093
# Listen address of the sidecar itself.
ABI_SCORE_ADDR=127.0.0.1:8093
# Where trained artifacts + the serving manifest live (shared by training and
# the sidecar; the path recorded in gold.model_registry).
ABI_ARTIFACTS_DIR=artifacts

# --- Phase 3 stream scoring + agent ---
# Consumer group of the stream score-writer (orders + clickstream replays).
ABI_CONSUMER_GROUP_SCORE_WRITER=score-writer
# Event-time disorder tolerance (seconds) the score-writer reorders by.
ABI_SCOREWRITER_SLACK=120
# Bounds the score-writer scoring job queue; overflow drops the oldest job.
ABI_SCOREWRITER_BUFFER=100000
# How often restart state (rings/rate windows) snapshots to gold.scorewriter_state.
ABI_SCOREWRITER_STATE_EVERY=30
# NL-BI agent sidecar (ml/agent/server.py). Empty ABI_AGENT_URL disables
# /api/v1/agent/query (serves 503 with a clear message).
ABI_AGENT_URL=http://127.0.0.1:8094
# Listen address of the agent sidecar itself.
ABI_AGENT_ADDR=127.0.0.1:8094
# mock = deterministic harness (no model needed); live = Ollama/OpenAI-compatible.
ABI_AGENT_MODE=mock
# LLM endpoint used by the agent in live mode (client appends /v1/chat/completions).
ABI_LLM_BASE_URL=http://127.0.0.1:11434
ABI_LLM_MODEL=qwen2.5:7b-instruct