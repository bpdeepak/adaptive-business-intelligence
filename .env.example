# --- Postgres (docker-compose + dbt profile + loader + Go API) ---
ABI_PG_HOST=localhost
ABI_PG_PORT=5432
ABI_PG_DB=abi
ABI_PG_USER=abi
ABI_PG_PASSWORD=abi

# --- MinIO (docker-compose + loader) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ABI_MINIO_ENDPOINT=http://localhost:9000
ABI_MINIO_ACCESS_KEY=minioadmin
ABI_MINIO_SECRET_KEY=minioadmin
ABI_MINIO_BUCKET=bronze

# --- Go API ---
# Binds the HTTP server; default :8080
ABI_HTTP_ADDR=:8080
# The API builds DATABASE_URL from ABI_PG_*; override explicitly if needed:
# DATABASE_URL=postgres://abi:abi@localhost:5432/abi?sslmode=disable